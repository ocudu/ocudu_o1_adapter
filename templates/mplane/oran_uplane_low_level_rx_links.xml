<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
<user-plane-configuration xmlns="urn:o-ran:uplane-conf:1.0">
{% for link in config.links %}  <low-level-rx-links>
    <name>{{ link.name }}</name>
    <processing-element>processing-element01</processing-element>
    <rx-array-carrier>{{ link.carrier }}</rx-array-carrier>
    <low-level-rx-endpoint>{{ link.endpoint }}</low-level-rx-endpoint>
  </low-level-rx-links>
{% endfor %}</user-plane-configuration>
</config>
