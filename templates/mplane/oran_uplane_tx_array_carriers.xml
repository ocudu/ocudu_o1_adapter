<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
<user-plane-configuration xmlns="urn:o-ran:uplane-conf:1.0">
{% for carrier_name in config.carrier_names %} <tx-array-carriers>
  <name>{{ carrier_name }}</name>
  <type>NR</type>
  <absolute-frequency-center>{{ config.dl_arfcn }}</absolute-frequency-center>
  <center-of-channel-bandwidth>{{ config.dl_freq }}</center-of-channel-bandwidth>
  <channel-bandwidth>{{ config.rf_bandwidth_hz }}</channel-bandwidth>
  <gain>{{ config.tx_gain }}</gain>
  <downlink-radio-frame-offset>0</downlink-radio-frame-offset>
  <downlink-sfn-offset>0</downlink-sfn-offset>
 </tx-array-carriers>
{% endfor %}</user-plane-configuration>
</config>
