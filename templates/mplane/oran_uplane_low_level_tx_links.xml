<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
<user-plane-configuration xmlns="urn:o-ran:uplane-conf:1.0">
{% for link in config.links %}    <low-level-tx-links>
      <name>{{ link.name }}</name>
      <processing-element>processing-element01</processing-element>
      <tx-array-carrier>{{ link.carrier }}</tx-array-carrier>
      <low-level-tx-endpoint>{{ link.endpoint }}</low-level-tx-endpoint>
    </low-level-tx-links>
{% endfor %}</user-plane-configuration>
</config>
