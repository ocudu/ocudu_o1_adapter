<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
<performance-measurement-objects xmlns="urn:o-ran:performance-management:1.0">
{% for measurement_object in config.rx_window_objects %}    <rx-window-measurement-objects>
        <measurement-object>{{ measurement_object }}</measurement-object>
        <active>true</active>
    </rx-window-measurement-objects>
{% endfor %}</performance-measurement-objects>
</config>
